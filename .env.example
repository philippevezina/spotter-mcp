# Local development. Copy to .env. Production values live in .env.local (never committed)
# and are used with: uv run --env-file .env.local spotter <command>
DATABASE_URL=postgresql://spotter:spotter@localhost:5432/spotter
# Direct (unpooled) connection, used for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Fernet key: uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
GARMIN_TOKEN_KEY=

# Phase 3 (server)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USER_ID=
JWT_SIGNING_KEY=
STORAGE_ENCRYPTION_KEY=
BASE_URL=https://spotter-mcp.vercel.app
